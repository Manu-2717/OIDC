{
  "name": "usar-foss-oidc",
  "version": "0.1.0",
  "private": true,
  "description": "OpenID Connect provider for USAR FOSS Club: one sign-in for every club app.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local-server.ts",
    "start": "tsx --env-file-if-exists=.env src/local-server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "example": "tsx examples/test-app/server.ts",
    "start:prod": "node dist/src/local-server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && STATE_BACKEND=upstash vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
    "client:new": "tsx scripts/client-new.ts",
    "clients:check": "tsx --env-file-if-exists=.env scripts/clients-check.ts",
    "accounts:seed": "tsx --env-file-if-exists=.env scripts/seed-accounts.ts",
    "account": "tsx --env-file-if-exists=.env scripts/account.ts",
    "test:postgres": "vitest run test/postgres.test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.11",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "oidc-provider": "^9.12.2",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.15.0",
    "cookie": "^2.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
