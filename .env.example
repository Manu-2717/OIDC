# The address of this service as it appears in every token. It must never change once an app uses it.
# Locally: http://localhost:3000. In production: https://oidc.fossclub.tech
ISSUER="http://localhost:3000"

# This service's own Postgres (the `ufc-oidc` Neon project). In production use the POOLED address and the restricted `oidc_app` login
# (see db/roles.sql). Migrations use the owner's DIRECT address instead: DATABASE_URL=<owner direct> npm run db:migrate
DATABASE_URL="postgresql://oidc_app:PASSWORD@HOST/neondb?sslmode=require"

# Read-only link to the main website's database, for "is this person a member?". It must be a login that can read only the
# `oidc_members_v` view (see docs/main-db-view.sql). Leave it unset and nobody is reported as a member.
# MAIN_DB_URL="postgresql://oidc_reader:PASSWORD@HOST/neondb?sslmode=require"

# Short lived state: sessions, codes, tokens, rate limit counters. Its own Upstash database, with EVICTION OFF.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# The GitHub OAuth app that people sign in with. Callback URL: <ISSUER>/callback/github
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# Secrets: make them with `npm run keys:generate`.
OIDC_JWKS='{"keys":[...]}'
COOKIE_KEYS="replace-me-at-least-32-characters-long"
CSRF_SECRET="replace-me-at-least-32-characters-long"

# One secret per confidential app, named after its client id in capitals with dashes as underscores (see clients.json).
# CLIENT_SECRET_QUIZ="replace-me"

# Where someone who is not a member is pointed to learn how to become one.
# MEMBERSHIP_INFO_URL="https://www.fossclub.tech"

# Local development only: how much to log (debug, info, warn, error).
# LOG_LEVEL="info"
